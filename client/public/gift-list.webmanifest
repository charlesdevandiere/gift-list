{
    "$schema": "https://json.schemastore.org/web-manifest-combined.json",
    "name": "Gift list",
    "short_name": "Gift list",
    "start_url": ".",
    "id": "/",
    "display": "standalone",
    "theme_color": "#0d6efd",
    "background_color": "#ffffff",
    "description": "Share your gift list with your family!",
    "categories": [
        "lifestyle"
    ],
    "shortcuts": [
        {
            "name": "Cart",
            "url": "./#/cart",
            "icons": [
                {
                    "src": "images/icons/cart.png",
                    "sizes": "96x96"
                }
            ]
        }
    ],
    "icons": [
        {
            "src": "images/icons/icon192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "images/icons/icon384.png",
            "sizes": "384x384",
            "type": "image/png"
        },
        {
            "src": "images/icons/icon512.png",
            "sizes": "512x512",
            "type": "image/png"
        },
        {
            "src": "images/icons/icon1024.png",
            "sizes": "1024x1024",
            "type": "image/png"
        },
        {
            "src": "images/icons/maskable_icon.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "images/icons/monochrome_icon.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "monochrome"
        }
    ],
    "screenshots": [
        {
            "src": "images/screenshots/gift-list_narrow_01_users.png",
            "sizes": "750x1334",
            "form_factor": "narrow",
            "label": "Each person has their own gift list"
        },
        {
            "src": "images/screenshots/gift-list_narrow_02_my_gifts.png",
            "sizes": "750x1334",
            "form_factor": "narrow",
            "label": "Add a gift to your list"
        },
        {
            "src": "images/screenshots/gift-list_narrow_03_gifts.png",
            "sizes": "750x1334",
            "form_factor": "narrow",
            "label": "Check your friends' gift list"
        },
        {
            "src": "images/screenshots/gift-list_wide_01_my_gifts.png",
            "sizes": "2048x1536",
            "form_factor": "wide",
            "label": "Add a gift to your list"
        },
        {
            "src": "images/screenshots/gift-list_wide_02_gifts.png",
            "sizes": "2048x1536",
            "form_factor": "wide",
            "label": "Check your friends' gift list"
        }
    ]
}