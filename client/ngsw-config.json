{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/gift-list.webmanifest",
          "en.json",
          "fr.json",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/fonts/*",
          "/images/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2|csv)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "users",
      "urls": [
        "/api/**"
      ],
      "version": 1,
      "cacheConfig": {
        "maxAge": "7d",
        "maxSize": 1000,
        "strategy": "freshness",
        "timeout": "1s"
      }
    }
  ]
}
