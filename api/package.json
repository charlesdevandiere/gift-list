{
  "name": "gift-list-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prisma-generate": "prisma generate",
    "prebuild": "rm -rf out-tsc && npm run prisma-generate",
    "build": "tsc",
    "postbuild": "cp -r ./src/generated/ ./out-tsc/generated/",
    "lint": "eslint .",
    "prestart": "tsc --sourceMap true",
    "start": "node --env-file=../.env out-tsc/main.js",
    "watch": "nodemon -w ./src -e 'ts,json' --exec \"npm start\""
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "papaparse": "^5.4.1",
    "passport": "^0.7.0",
    "passport-http": "^0.3.0",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.8.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.15",
    "@types/passport": "^1.0.17",
    "@types/passport-http": "^0.3.11",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/winston": "^2.4.4",
    "@types/yaml": "^1.9.6",
    "eslint": "^9.17.0",
    "nodemon": "^3.1.9",
    "prisma": "^6.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
