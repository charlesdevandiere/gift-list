// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Group {
  name     String          @id @db.VarChar(255)
  password String          @db.VarChar(255)
  users    UsersOnGroups[]
}

model User {
  id      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name    String          @db.VarChar(255)
  picture String?         @db.VarChar(255)
  gifts   Gift[]
  cart    Gift[]          @relation(name: "CartOnUser")
  groups  UsersOnGroups[]
}

model UsersOnGroups {
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String @db.Uuid
  group     Group  @relation(fields: [groupName], references: [name], onDelete: Cascade)
  groupName String @db.VarChar(255)
  order     Int    @db.SmallInt

  @@id([userId, groupName])
}

model Gift {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String  @db.Uuid
  order           Int     @db.SmallInt
  name            String  @db.Text
  link1           String? @db.Text
  link2           String? @db.Text
  link3           String? @db.Text
  offeredByUserId String? @db.Uuid
  offeredByUser   User?   @relation(name: "CartOnUser", fields: [offeredByUserId], references: [id], onDelete: SetNull)
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
